# ---- Database ----
DB_USERNAME=root
DB_PASSWORD=root

# ---- JWT ----
# Keep this line COMMENTED while sqms.jwt.secret is written directly in application.properties.
# An empty "JWT_SECRET=" line is what caused the "0 bits" start-up error.
# Before production: generate 48+ random characters (openssl rand -base64 48), put them here, and change
# application.properties back to  sqms.jwt.secret=${JWT_SECRET}
# JWT_SECRET=

# ---- First Super Admin ----
# Removed on purpose: a Super Admin already exists, so BOOTSTRAP_ADMIN_* is ignored.
# Use "Forgot password" to set a new password for the existing Super Admin.

