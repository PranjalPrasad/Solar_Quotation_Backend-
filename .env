MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=pranjalprasad459@gmail.com
# Paste a NEW Gmail App Password here (16 characters, no spaces). The old one was shared in a chat: revoke it first
